# Copy to ~/.config/chess-guesser/stockfish-pool.env and `chmod 600` it.
# Written only when this deploy is the one starting the pool. An existing
# file, including chess-learner's, is never modified.
# Format (podman --env-file): KEY=value per line. No quotes, no inline
# comments, no $ expansion: everything after = is the value.

# Bearer token(s) the app must present. Generate with: openssl rand -hex 32
# chess-guesser.env ENGINE_TOKEN must be one of these values.
API_TOKENS=

# Optional overrides; the defaults suit a 3 vCPU / 4 GB VPS shared with other
# services (see https://github.com/cpmurphy/stockfish-pool for every setting).
# POOL_SIZE=2
# GLOBAL_ENGINE_SEC_PER_MIN=90
# INTERACTIVE_MAX_DEPTH=18
