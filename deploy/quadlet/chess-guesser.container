[Unit]
Description=chess-guesser web app
Wants=stockfish-pool.service
After=stockfish-pool.service

[Container]
Image=localhost/chess-guesser:app
ContainerName=chess-guesser
# The engine network is internal and is shared with the pool. When chess-learner
# is already running, that network and the pool already exist; this unit only
# joins them. It does not publish the pool or take learner's web address.
Network=sf-engine.network
# Reachable only from this host, i.e. from Caddy. Host and container both use 3000.
PublishPort=127.0.0.1:3000:3000
EnvironmentFile=%h/.config/chess-guesser/chess-guesser.env
Environment=APP_ENV=production ENGINE_URL=http://stockfish-pool:4000 HOME=/tmp
ReadOnly=true
Tmpfs=/tmp:rw,size=64m,mode=1777
DropCapability=ALL
NoNewPrivileges=true
PodmanArgs=--memory=768m --memory-swap=768m --pids-limit=128
HealthCmd=/app/bin/healthcheck
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
