# Copy to ~/.config/chess-guesser/chess-guesser.env and `chmod 600` it.
# Format (podman --env-file): KEY=value per line. No quotes, no inline
# comments, no $ expansion: everything after = is the value.
#
# ENGINE_TOKEN must be one of the running pool's API_TOKENS. deploy/remote-install.sh
# copies an existing token and never replaces one that is already set.

# Same value as one entry of API_TOKENS in the stockfish-pool env file.
ENGINE_TOKEN=
